{
  "name": "chanman-soundboard",
  "version": "1.0.0",
  "description": "Simple soundboard",
  "license": "CC BY-NC 4.0",
  "author": "CHAN MAN KIT",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.chanman.chanman-soundboard",
    "productName": "chanman-soundboard",
    "directories": {
      "output": "dist"
    },
    "win": { 
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
